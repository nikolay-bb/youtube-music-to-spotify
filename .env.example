# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored. Never commit it.

# ---------------------------------------------------------------------------
# Spotify
# ---------------------------------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard
#
# IMPORTANT: in the app settings, add this EXACT redirect URI:
#     http://127.0.0.1:8000/api/auth/spotify/callback
# Spotify rejects "localhost". It must be the IP address 127.0.0.1.
#
# Also add your own Spotify account email under "User Management".
# Development Mode allows 5 users and needs the app owner to have Premium.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback

# ---------------------------------------------------------------------------
# YouTube Music (ytmusicapi OAuth)
# ---------------------------------------------------------------------------
# 1. Go to https://console.cloud.google.com and make a project.
# 2. Enable the "YouTube Data API v3".
# 3. Set up the consent screen (External), and add yourself as a test user.
# 4. Create an OAuth client ID of type "Web application".
#    Add this exact Authorised redirect URI:
#        http://127.0.0.1:8000/api/auth/youtube/callback
# 5. Paste the id and secret below, then press Connect YouTube in the app.
YTM_CLIENT_ID=
YTM_CLIENT_SECRET=
YTM_REDIRECT_URI=http://127.0.0.1:8000/api/auth/youtube/callback

# ---------------------------------------------------------------------------
# Matching thresholds (0.0 - 1.0)
# ---------------------------------------------------------------------------
# At or above MATCH_THRESHOLD  -> added to the playlist automatically.
# Between REVIEW and MATCH     -> held back and listed in the report.
# Below REVIEW_THRESHOLD       -> treated as not found.
#
# Lower MATCH_THRESHOLD if the report has too many "low confidence" rows and
# you trust the guesses. Raise it if a wrong song slipped through.
MATCH_THRESHOLD=0.86
REVIEW_THRESHOLD=0.70

# ---------------------------------------------------------------------------
# Rate limiting. Spotify Development Mode has low limits.
#
# One request at a time with a 400ms gap is about 2.5 searches a second, which
# a large library can sustain without hitting QUOTA_EXCEEDED. Raising these
# makes it faster until it stops entirely, which is slower.
# ---------------------------------------------------------------------------
# Search queries tried per song, 1 to 3. Spotify's daily search quota is
# about 1,000 requests, so this directly sets how many songs fit in a day:
#   3 -> ~1.5 requests/song -> ~650 songs a day (best matching)
#   2 -> ~1.3 requests/song -> ~770 songs a day
#   1 -> 1 request/song     -> ~1000 songs a day (misses more)
MAX_QUERIES_PER_SONG=3

SPOTIFY_MAX_CONCURRENCY=1
SPOTIFY_REQUEST_DELAY_MS=400

# Where the browser should be sent back to after a successful Spotify login.
FRONTEND_URL=http://127.0.0.1:3000
